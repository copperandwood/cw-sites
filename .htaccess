# Toutes les adresses du site mènent à la billetterie du concert (lien de l'affiche),
# sauf la page de politique de confidentialité (exigée par Meta pour l'application de l'association).
# 302 (temporaire) : les navigateurs ne la gardent pas en cache, la cible peut changer.
# QSD : le chemin et les paramètres demandés ne sont pas ajoutés à l'adresse HelloAsso.
RewriteEngine On
RewriteRule ^confidentialite/?$ /confidentialite.html [L]
RewriteRule !^confidentialite\.html$ https://www.helloasso.com/associations/ensemble-copper-wood/evenements/copper-and-wood-big-band-en-concert [R=302,L,QSD]
